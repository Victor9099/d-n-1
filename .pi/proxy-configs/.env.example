# ═══════════════════════════════════════════
# Environment Variables for LiteLLM Proxy
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your keys

# ═══════════════════════════════════════════
# LLM Provider API Keys
# ═══════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI (GPT)
OPENAI_API_KEY=your-openai-key-here

# Google (Gemini)
GOOGLE_API_KEY=your-google-key-here

# OpenRouter (100+ models)
OPENROUTER_API_KEY=your-openrouter-key-here

# ═══════════════════════════════════════════
# LiteLLM Proxy Settings
# ═══════════════════════════════════════════

# Master key for accessing the proxy
# Generate a strong random key: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-your-proxy-master-key-here

# ═══════════════════════════════════════════
# Database (PostgreSQL)
# ═══════════════════════════════════════════

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# ═══════════════════════════════════════════
# Redis (Caching)
# ═══════════════════════════════════════════

# Redis password (leave empty for no password)
REDIS_PASSWORD=your-redis-password-here

# ═══════════════════════════════════════════
# Optional: Additional Providers
# ═══════════════════════════════════════════

# Azure OpenAI
# AZURE_API_KEY=your-azure-key
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-02-15-preview

# AWS Bedrock
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION_NAME=us-east-1

# Cohere
# COHERE_API_KEY=your-cohere-key

# Mistral
# MISTRAL_API_KEY=your-mistral-key

# ═══════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════
#
# 1. Never commit .env file to git!
# 2. Use strong, unique keys for each service
# 3. Rotate keys regularly
# 4. Use environment-specific keys (dev/staging/prod)
#
# ═══════════════════════════════════════════
