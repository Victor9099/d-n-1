{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "codegen": {
      "dependsOn": [],
      "outputs": ["contracts/generated/**"]
    },
    "db:generate": {
      "dependsOn": [],
      "outputs": ["node_modules/.prisma/**"]
    },
    "db:migrate:dev": {
      "dependsOn": [],
      "cache": false
    },
    "db:migrate:deploy": {
      "dependsOn": [],
      "cache": false
    },
    "db:validate": {
      "dependsOn": [],
      "outputs": []
    },
    "db:seed": {
      "dependsOn": ["db:migrate:deploy"],
      "cache": false
    }
  }
}
